# Voice Agent — environment variables
# Copy to .env and fill in values before running
# GATEWAY_API_KEY: get this from your NestJS gateway
#   (POST /api/v1/keys to create one)

# LiveKit server connection
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Deepgram API key (for STT and TTS)
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# NestJS LLM gateway
GATEWAY_URL=http://localhost:3000
GATEWAY_API_KEY=your_gateway_api_key_here
GATEWAY_MODEL=claude-haiku-4-5-20251001

# Logging
LOG_LEVEL=INFO
